{
  "corpus": [
    {
      "id": "DOC-01",
      "title": "风险测评",
      "text": "基金产品风险等级与投资者承受能力需匹配。有效测评、目标、资金期限和自有资金信息齐备后，再提供比较候选。",
      "keywords": [
        "风险",
        "测评",
        "等级"
      ],
      "version": "2026-10-09",
      "source": "人工编写的基金场景演示资料",
      "approved": true,
      "effective_from": "2026-01-01",
      "effective_to": null
    },
    {
      "id": "DOC-02",
      "title": "产品费用",
      "text": "申购、管理、托管、销售服务及赎回费用需要分别核对。演示中短债基金前端申购费为0.30%；真实费用以生效资料及渠道公示为准。",
      "keywords": [
        "费用",
        "费率",
        "手续费",
        "申购"
      ],
      "version": "2026-10-09",
      "source": "人工编写的基金场景演示资料",
      "approved": true,
      "effective_from": "2026-01-01",
      "effective_to": null
    },
    {
      "id": "DOC-03",
      "title": "赎回安排",
      "text": "赎回到账安排与费用受到产品规则、申请时点及持有时长影响，不能统一承诺即时到账；应查看当前产品资料。",
      "keywords": [
        "赎回",
        "到账",
        "流动性"
      ],
      "version": "2026-10-09",
      "source": "人工编写的基金场景演示资料",
      "approved": true,
      "effective_from": "2026-01-01",
      "effective_to": null
    },
    {
      "id": "DOC-04",
      "title": "定投规则",
      "text": "定投可用于分散投入时点，但不能消除亏损风险。扣款失败时先核对账户余额、扣款授权与日期，不自动补扣或加仓。",
      "keywords": [
        "定投",
        "扣款"
      ],
      "version": "2026-10-09",
      "source": "人工编写的基金场景演示资料",
      "approved": true,
      "effective_from": "2026-01-01",
      "effective_to": null
    },
    {
      "id": "DOC-05",
      "title": "净值波动",
      "text": "净值波动不构成自动买卖指令。先确认资金使用期限与承受能力，再理解基金投资范围和风险。过往业绩不代表未来表现。",
      "keywords": [
        "净值",
        "回落",
        "跌",
        "亏"
      ],
      "version": "2026-10-09",
      "source": "人工编写的基金场景演示资料",
      "approved": true,
      "effective_from": "2026-01-01",
      "effective_to": null
    },
    {
      "id": "DOC-06",
      "title": "基金比较",
      "text": "比较基金应同时看投资范围、风险、费用和资金使用期限。货币基金不是银行存款；债券基金会波动；指数基金承担市场风险。",
      "keywords": [
        "比较",
        "对比",
        "浏览",
        "基金"
      ],
      "version": "2026-10-09",
      "source": "人工编写的基金场景演示资料",
      "approved": true,
      "effective_from": "2026-01-01",
      "effective_to": null
    },
    {
      "id": "DOC-07",
      "title": "长期持有",
      "text": "宽基指数基金（演示）只进入风险C4以上且资金期限至少36个月的比较候选。该期限是演示过滤策略，不是法定持有期限或收益保证。",
      "keywords": [
        "持有",
        "指数",
        "长期"
      ],
      "version": "2026-10-09",
      "source": "人工编写的基金场景演示资料",
      "approved": true,
      "effective_from": "2026-01-01",
      "effective_to": null
    },
